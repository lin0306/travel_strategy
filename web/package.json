{
  "name": "travel-strategy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "行迹 · 城市旅游攻略 —— 地图即画布 + 三级下钻 + 行程规划（纯静态 SSG）",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "vite preview --port 4173",
    "typecheck": "react-router typegen && tsc --noEmit",
    "check": "python ../tools/check_app.py",
    "data:validate": "python ../pipeline/run.py build --strict",
    "data:build": "python ../pipeline/run.py build"
  },
  "dependencies": {
    "@react-router/node": "^7.9.1",
    "lz-string": "^1.5.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "^7.9.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@react-router/dev": "^7.9.1",
    "@tailwindcss/vite": "^4.1.13",
    "@types/lz-string": "^1.3.34",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
